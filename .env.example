# --- server ---
PORT=8787
# Optional: protect ingest/board-admin endpoints (header: x-admin-token)
ADMIN_TOKEN=
# Minutes between automatic ingests
INGEST_INTERVAL_MIN=30

# --- alerts: email (Resend) ---
# https://resend.com — free tier: 100 emails/day
RESEND_API_KEY=
ALERT_FROM_EMAIL="JobRadar <jobradar@yourdomain.com>"
ALERT_TO_EMAIL=you@example.com

# --- alerts: whatsapp (Meta Cloud API) ---
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ALERT_TO_WHATSAPP=919999999999
